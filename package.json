{
  "name": "portfolio",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "setup": "npm run db:start && npm run env:local && npm run db:deploy && npm run storage:setup && npm run db:test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "env:local": "tsx scripts/write-local-env.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:deploy": "tsx scripts/db.ts deploy",
    "db:harden": "tsx scripts/db-harden.ts",
    "db:test": "tsx scripts/test-db.ts",
    "storage:setup": "tsx scripts/storage-setup.ts",
    "auth:schema": "auth generate --config scripts/auth-schema.ts --adapter prisma --dialect postgresql --output generated/auth-schema.prisma --yes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gate": "npm run format && npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.118.0",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.10",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "shadcn": "4.21.2",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  }
}
