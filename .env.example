# `npm run setup` copies this file to .env.local and fills in the local Supabase
# values and a Better Auth secret (npm run env:local). Fill in the rest yourself.
# lib/env.ts validates every variable at startup.

# Absolute base for canonical and social URLs. Set the final domain before sharing links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres. DATABASE_URL is pooled (transaction pooler in production); DIRECT_URL is for migrations.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth. Secret of 32+ random bytes: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Supabase, server only. The sb_secret_ key must never reach the browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# Supabase, client. Only used for uploads to signed URLs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin account, read by `npm run seed:admin` only. Password: 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Email. Optional in dev: the console sender is used when RESEND_API_KEY is empty.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_INBOX=

# Cloudflare Turnstile. Optional spam protection for sign-up and contact.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The /design page is always on in `next dev`. Set to "on" to serve it from a
# production build too (the e2e tests do). Leave empty in production.
DESIGN_PAGE=
