generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql" // URL lives in prisma.config.ts (Prisma 7)
}

// Better Auth models, generated by its CLI and then edited: role and locale
// are enums, and User has the app relations. After a Better Auth upgrade, run
// `npm run auth:schema` and diff generated/auth-schema.prisma against these.

model User {
  id            String            @id
  name          String
  email         String
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  role          Role?
  banned        Boolean?          @default(false)
  banReason     String?
  banExpires    DateTime?
  locale        Locale? // language for emails (Better Auth additionalFields)
  sessions      Session[]
  accounts      Account[]
  posts         Post[]
  comments      Comment[]
  bookmarks     Bookmark[]
  progress      EpisodeProgress[]
  uploads       Media[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// App models (docs/PLAN.md, Data model). Long bilingual text lives in a
// translation table with one row per locale; a missing row means the item is
// not published in that language. Short labels use nameAr/nameEn columns.

enum Role {
  admin
  user
  guest
}

enum Locale {
  ar
  en
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectTrack {
  BIOMEDICAL
  HEALTH_SOFTWARE
  SOFTWARE
}

enum ResourceKind {
  NOTES
  SLIDES
  FIGURE
  DATASET
  OTHER
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
  SPAM
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TimelineKind {
  EDUCATION
  WORK
  TRAINING
  CERTIFICATE
}

enum SkillGroup {
  MEDICAL_DEVICES
  ELECTRONICS
  SOFTWARE
  TOOLS
  LANGUAGES
}

enum BookmarkTarget {
  POST
  EPISODE
  PROJECT
}

model Media {
  id           String   @id @default(cuid())
  bucket       String
  path         String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altAr        String?
  altEn        String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  projectCovers    Project[]         @relation("ProjectCover")
  postCovers       Post[]            @relation("PostCover")
  postOgImages     Post[]            @relation("PostOgImage")
  episodeCovers    Episode[]         @relation("EpisodeCover")
  episodeResources EpisodeResource[]

  @@unique([bucket, path])
}

model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  nameAr   String
  nameEn   String
  posts    Post[]
  projects Project[]
}

model Project {
  id           String               @id @default(cuid())
  slug         String               @unique
  track        ProjectTrack
  status       ContentStatus        @default(DRAFT)
  featured     Boolean              @default(false)
  sortOrder    Int                  @default(0)
  coverId      String?
  cover        Media?               @relation("ProjectCover", fields: [coverId], references: [id], onDelete: SetNull)
  repoUrl      String?
  liveUrl      String?
  startedAt    DateTime?
  endedAt      DateTime?
  publishedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ProjectTranslation[]
  tags         Tag[]

  @@index([status, featured, sortOrder])
}

model ProjectTranslation {
  id             String  @id @default(cuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String
  summary        String
  body           Json // Plate editor value
  myRole         String?
  seoTitle       String?
  seoDescription String?

  @@unique([projectId, locale])
}

model Post {
  id           String            @id @default(cuid())
  slug         String            @unique
  status       ContentStatus     @default(DRAFT)
  featured     Boolean           @default(false)
  coverId      String?
  cover        Media?            @relation("PostCover", fields: [coverId], references: [id], onDelete: SetNull)
  ogImageId    String? // optional override of the generated social image
  ogImage      Media?            @relation("PostOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  authorId     String
  author       User              @relation(fields: [authorId], references: [id])
  publishedAt  DateTime?
  viewCount    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translations PostTranslation[]
  tags         Tag[]
  comments     Comment[]

  @@index([status, publishedAt])
}

model PostTranslation {
  id             String  @id @default(cuid())
  postId         String
  post           Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String
  excerpt        String
  content        Json // Plate editor value
  contentText    String // plain text: search, reading time, fallback description
  readingMinutes Int
  seoTitle       String?
  seoDescription String?

  @@unique([postId, locale])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([postId, status, createdAt])
}

model Episode {
  id           String               @id @default(cuid())
  slug         String               @unique
  season       Int                  @default(1)
  number       Int
  status       ContentStatus        @default(DRAFT)
  youtubeId    String?
  durationMin  Int?
  coverId      String?
  cover        Media?               @relation("EpisodeCover", fields: [coverId], references: [id], onDelete: SetNull)
  publishedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations EpisodeTranslation[]
  resources    EpisodeResource[]
  progress     EpisodeProgress[]

  @@unique([season, number])
}

model EpisodeTranslation {
  id             String  @id @default(cuid())
  episodeId      String
  episode        Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String
  deviceName     String
  summary        String
  body           Json
  seoTitle       String?
  seoDescription String?

  @@unique([episodeId, locale])
}

model EpisodeResource {
  id              String       @id @default(cuid())
  episodeId       String
  episode         Episode      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  kind            ResourceKind
  locale          Locale? // null = language-neutral, e.g. a figure
  mediaId         String
  media           Media        @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  requiresAccount Boolean      @default(false)
  downloads       Int          @default(0)
  sortOrder       Int          @default(0)
}

model EpisodeProgress {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId   String
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([userId, episodeId])
}

model Bookmark {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType BookmarkTarget
  targetId   String
  createdAt  DateTime       @default(now())

  @@unique([userId, targetType, targetId])
}

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  body      String
  locale    Locale
  status    MessageStatus @default(NEW)
  ipHash    String? // salted hash, never the raw IP
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

model TimelineEntry {
  id           String                @id @default(cuid())
  kind         TimelineKind
  startDate    DateTime
  endDate      DateTime?
  sortOrder    Int                   @default(0)
  translations TimelineTranslation[]
}

model TimelineTranslation {
  id          String        @id @default(cuid())
  entryId     String
  entry       TimelineEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  locale      Locale
  title       String
  org         String
  description String?

  @@unique([entryId, locale])
}

model Skill {
  id        String     @id @default(cuid())
  group     SkillGroup
  nameAr    String
  nameEn    String
  sortOrder Int        @default(0)
}

model Setting {
  key       String   @id // site, social, cv, seo, features
  value     Json // validated by a Zod schema per key
  updatedAt DateTime @updatedAt
}
